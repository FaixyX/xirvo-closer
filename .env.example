# Application
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Embeddings
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=3072

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=xirvo_rag
DB_USER=postgres
DB_PASSWORD=

# RAG
RAG_TOP_K=5
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=80

# Knowledge Base
KNOWLEDGE_BASE_PATH="data/Xirvo Sales Chatbot — RAG Knowledge Base.pdf"

# Public commercial policy
STANDARD_HOURLY_RATE=40
MIN_PROJECT_AMOUNT=500

# Backend-only commercial qualification (never expose to Gemini, frontend, or clients)
INTERNAL_MIN_HOURLY_RATE=25
